# =============================================================
#  Universal Bank Parser — Environment Configuration Template
#  BUG-40 FIX: Copy this file to .env and fill in all values.
#  NEVER commit your actual .env file to version control!
# =============================================================

# ── Server ────────────────────────────────────────────────────
PORT=5000

# ── Security (REQUIRED) ───────────────────────────────────────
# A long, random secret string for signing JWT tokens (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_random_jwt_secret_here_min_32_chars

# Master Super Admin password (used to bootstrap the first admin login)
MASTER_ADMIN_PASSWORD=your_strong_master_admin_password_here

# ── AWS Configuration (REQUIRED) ──────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ── CORS (Production Only) ────────────────────────────────────
# Comma-separated list of allowed frontend origins in production.
# Leave unset for local development (defaults to localhost:5173).
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
